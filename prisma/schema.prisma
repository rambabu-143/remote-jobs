// ponytail: classic prisma-client-js generator, not the newer prisma-client one.
// The newer generator bakes an absolute build-time path into the client for
// locating its query engine binary, which breaks on Vercel's Lambda runtime
// (build path and execution path differ there). prisma-client-js resolves
// relatively and has long-standing, battle-tested support in Next.js's own
// output file tracing.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// USER = job seeker (applies to jobs), EMPLOYER = posts jobs, ADMIN = runs the site.
enum Role {
  USER
  EMPLOYER
  ADMIN
}

enum RemoteType {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  ACCEPTED
}

// DRAFT: employer-created, not yet paid for. PENDING: paid, awaiting admin
// review. PUBLISHED: live. REJECTED: admin declined. CLOSED: was published,
// taken down (by admin or employer). Admin-created jobs skip straight to
// PUBLISHED (no payment, no review) via saveJob.
enum JobStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  CLOSED
}

enum SubscriptionPlan {
  MONTH_1
  MONTH_6
  YEAR_1
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

// id is not auto-generated: it must match the Supabase Auth user's id
// (auth.users.id) so this row is that user's profile + role.
model User {
  id                    String            @id
  name                  String
  email                 String            @unique
  role                  Role              @default(USER)
  subscriptionPlan      SubscriptionPlan?
  subscriptionExpiresAt DateTime?
  // "soon:<expiry>" or "expired:<expiry>": the last plan-expiry reminder sent for that expiry date.
  reminderSent          String?
  createdAt             DateTime          @default(now())
  jobs                  Job[]             @relation("PostedJobs")
  applications          Application[]
  payments              Payment[]
  jobPayments           JobPayment[]
  savedJobs             SavedJob[]
}

// ponytail: fixed-term access (pay once, expires, pay again), not recurring
// billing. No Razorpay Subscriptions API / renewal webhooks needed.
model Payment {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id])
  userId            String
  plan              SubscriptionPlan
  amountInPaise     Int
  razorpayOrderId   String           @unique
  razorpayPaymentId String?
  status            PaymentStatus    @default(CREATED)
  createdAt         DateTime         @default(now())
}

// One-off payment for a single job listing (flat fee), separate from the
// seeker apply-access Payment model above. 1:1 with Job: a job only ever
// has one paid listing order.
model JobPayment {
  id                String        @id @default(cuid())
  job               Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId             String        @unique
  user              User          @relation(fields: [userId], references: [id])
  userId            String
  amountInPaise     Int
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
}

model Job {
  id             String         @id @default(cuid())
  title          String
  company        String
  category       String         @default("Non-Tech")
  description    String
  location       String
  remoteType     RemoteType     @default(REMOTE)
  employmentType EmploymentType @default(FULL_TIME)
  salaryMin      Int?
  salaryMax      Int?
  tags           String         @default("")
  applyUrl       String?
  applyEmail     String?
  logoUrl        String?
  companyAddress String?
  companyEmail   String?
  companyPhone   String?
  status         JobStatus      @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  postedBy       User           @relation("PostedJobs", fields: [postedById], references: [id])
  postedById     String
  applications   Application[]
  questions      JobQuestion[]
  payment        JobPayment?
  savedBy        SavedJob[]

  // ponytail: covers the default (unfiltered) listing query; the other
  // indexes cover the equality filters the jobs page's FilterBar exposes.
  @@index([status, createdAt])
  @@index([category])
  @@index([location])
  @@index([remoteType])
  @@index([employmentType])
}

// ponytail: admin re-saving a job replaces its question set wholesale (deleteMany + createMany);
// answers to removed questions cascade-delete with them. Fine for MVP screening questions,
// revisit with soft-delete/versioning if historical answers need to survive question edits.
model JobQuestion {
  id       String              @id @default(cuid())
  job      Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  question String
  order    Int                 @default(0)
  answers  ApplicationAnswer[]
}

model Application {
  id             String              @id @default(cuid())
  job            Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  applicant      User                @relation(fields: [applicantId], references: [id])
  applicantId    String
  resumeFileName String? // null = applied on the company site
  coverNote      String?
  status         ApplicationStatus   @default(PENDING)
  createdAt      DateTime            @default(now())
  answers        ApplicationAnswer[]

  @@unique([jobId, applicantId])
}

model ApplicationAnswer {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  question      JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId    String
  answer        String

  @@unique([applicationId, questionId])
}

// Site-wide settings the admin can change from /admin/settings.
// employerPlanRequired = "true" -> employers need the paid plan to submit jobs; "false" -> free posting
// (every job is still approved by an admin).
model Setting {
  key   String @id
  value String
}

// A job a seeker bookmarked to apply to later.
model SavedJob {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}
