DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Optional: email notifications (new application -> admin, status change -> applicant).
# Without these, emails are just logged to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="RemoteJobs <onboarding@resend.dev>"
APP_URL="http://localhost:3000"

# Required for the subscription/paywall feature (/pricing). Get test keys from
# the Razorpay dashboard -> Settings -> API Keys. RAZORPAY_WEBHOOK_SECRET is
# set when you add the webhook endpoint under Settings -> Webhooks.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
