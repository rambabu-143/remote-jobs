DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Optional: email notifications (new application -> admin, status change -> applicant).
# Without these, emails are just logged to the server console instead of sent.
