# Supabase (Auth, Postgres, Storage) -- Project Settings -> API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Postgres connection strings -- Project Settings -> Database -> Connect (Prisma tab)
# DATABASE_URL: pooled (pgbouncer), used at runtime. DIRECT_URL: unpooled, used for migrations.
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# Optional: email notifications (new application -> admin, status change -> applicant).
# Without these, emails are just logged to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="RemoteJobs <onboarding@resend.dev>"
APP_URL="http://localhost:3000"

# Required for the subscription/paywall feature (/pricing). Get test keys from
# the Razorpay dashboard -> Settings -> API Keys. RAZORPAY_WEBHOOK_SECRET is
# set when you add the webhook endpoint under Settings -> Webhooks.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
